{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ivjnmymuifbuwviibjul.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "usop-mcp",
      "version": "0.1.0",
      "title": "Usop — Parking Marketplace"
    },
    "tools": [
      {
        "name": "list_open_slots",
        "title": "List open parking slots",
        "description": "List parking slots currently marked as open on Usop. Optionally filter by vehicle type and max hourly rate.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "vehicle_type": {
              "description": "Filter by vehicle type.",
              "type": "string",
              "enum": [
                "car",
                "bike",
                "both"
              ]
            },
            "max_hourly_rate": {
              "description": "Only slots at or below this hourly rate.",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "limit": {
              "description": "Max results (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_slot",
        "title": "Get parking slot details",
        "description": "Get details for a single parking slot by id. Full address and access instructions are only revealed via the app after a booking is confirmed.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slot_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The slot id."
            }
          },
          "required": [
            "slot_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_my_reservations",
        "title": "List my reservations",
        "description": "List parking reservations for the signed-in driver. Optionally filter by status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "upcoming",
                "active",
                "completed",
                "cancelled"
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_my_slots",
        "title": "List my parking slots",
        "description": "List parking slots owned by the signed-in landowner, including current open/full status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "set_slot_status",
        "title": "Set slot open/full status",
        "description": "Mark one of the landowner's own parking slots as open or full.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slot_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "status": {
              "type": "string",
              "enum": [
                "open",
                "full"
              ]
            }
          },
          "required": [
            "slot_id",
            "status"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
