# Copy to .env.local for local development. Placeholders only — never commit real values.
# Public (safe in browser; .env is managed by Lovable Cloud)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=your-referrer-restricted-browser-key
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=your-tracking-id

# Server-only secrets (set in Project Settings -> Secrets, never in the repo)
SUPABASE_SERVICE_ROLE_KEY=
LOVABLE_API_KEY=
LOVABLE_SEND_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_REFUNDS_ENABLED=false

# Database tests (test database only)
RUN_DB_TESTS=
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=

# Playwright e2e
E2E_BASE_URL=http://localhost:8080
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
